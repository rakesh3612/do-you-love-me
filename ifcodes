// week4 slider
<!DOCTYPE html>
<html>
<head>
<title>Slider</title>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<style>
body{
    background:black;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
}

.slider{text-align:center;padding:40px 0;}

img{width:400px;height:250px;display:none;}
.active{display:block;}

.controls{margin-top:20px;}
button{margin:5px;}
</style>
</head>

<body>

<div class="slider">
    <img src="Images/4.jpg" class="active">
    <img src="Images/4.jpg">
    <img src="Images/1.jpg">
    <img src="Images/2.jpg">
    <img src="Images/3.jpg">

    <div class="controls">
        <button onclick="slide('prev')">Previous</button>
        <button onclick="auto(this)">Start</button>
        <button onclick="slide('next')">Next</button>
    </div>
</div>

<script>
var run=false, t;

function slide(d){
    var c=$(".active");
    var n=(d=="next")? c.next("img"):c.prev("img");

    if(!n.length) n=(d=="next")? $("img:first"):$("img:last");

    c.removeClass("active");
    n.addClass("active");
}

function auto(b){
    if(!run){
        t=setInterval(()=>slide("next"),1000);
        run=true; b.innerText="Stop";
    }else{
        clearInterval(t);
        run=false; b.innerText="Start";
    }
}
</script>

</body>
</html>
